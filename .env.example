# Server-side OpenAI key. Never expose this through a Vite/VITE_ or REACT_APP_ variable.
OPENAI_API_KEY=

# Comma-separated browser origins allowed to call the API cross-origin.
# Example: ALLOWED_ORIGINS=https://promptcraft.example.com,https://www.promptcraft.example.com
ALLOWED_ORIGINS=

# Set to 1 only when the Express server is behind a trusted reverse proxy.
TRUST_PROXY=0
